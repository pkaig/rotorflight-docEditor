{
  "name": "rotorflight-doceditor",
  "version": "1.0.0",
  "private": true,
  "description": "Rotorflight Documentation Editor",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:electron": "tsc -p electron",
    "build": "npm run build:frontend && npm run build:backend && npm run build:electron",
    "electron:start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  },
  "build": {
    "appId": "org.rotorflight.docseditor",
    "productName": "Rotorflight Docs Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "backend/dist", "to": "backend/dist" },
      { "from": "backend/node_modules", "to": "backend/node_modules" },
      { "from": "backend/package.json", "to": "backend/package.json" },
      { "from": "frontend/dist", "to": "frontend/dist" },
      { "from": "electron/icon.ico", "to": "electron/icon.ico" }
    ],
    "win": { "target": "nsis", "icon": "electron/icon.ico" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
